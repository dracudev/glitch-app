---
import BaseLayout from './BaseLayout.astro';
import ThemeToggle from '@/components/ui/ThemeToggle';

interface Props {
  title: string;
  description?: string;
  noIndex?: boolean;
}

const { title, description, noIndex = true } = Astro.props;

const currentYear = new Date().getFullYear();
---

<BaseLayout title={title} description={description} noIndex={noIndex}>
  <slot name="head" slot="head" />

  <div class="flex min-h-screen flex-col">
    <header class="border-b border-border">
      <div class="shell flex h-16 items-center justify-between">
        <a href="/" class="flex items-center gap-2 text-foreground transition-colors hover:text-accent">
          <img
            src="/images/glitch-isotype.png"
            alt=""
            width="32"
            height="32"
            class="size-8 rounded-md"
          />
          <span class="font-display text-lg font-semibold tracking-tight">Glitch</span>
        </a>
        <ThemeToggle client:load />
      </div>
    </header>

    <main id="main" class="flex flex-1 items-center justify-center px-4 py-12 sm:px-6 lg:px-8">
      <slot />
    </main>

    <footer class="border-t border-border">
      <div class="shell flex flex-col items-center justify-between gap-4 py-6 sm:flex-row">
        <p class="text-sm text-muted-foreground">
          &copy; {currentYear} Glitch. All rights reserved.
        </p>
        <nav class="flex items-center gap-4 text-sm text-muted-foreground">
          <a href="/privacy" class="transition-colors hover:text-foreground">Privacy</a>
          <a href="/terms" class="transition-colors hover:text-foreground">Terms</a>
          <a href="/support" class="transition-colors hover:text-foreground">Support</a>
        </nav>
      </div>
    </footer>
  </div>
</BaseLayout>
