---
import MainLayout from './MainLayout.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Glitch administration', ...rest } = Astro.props;

const currentPath = Astro.url.pathname;

const sections = [
  { label: 'Overview', href: '/admin' },
  { label: 'Users', href: '/admin/users' },
  { label: 'Reviews', href: '/admin/reviews' },
];

const isActive = (href: string) =>
  href === '/admin' ? currentPath === '/admin' : currentPath.startsWith(href);
---

<MainLayout title={title} description={description} noIndex {...rest}>
  <div class="shell py-8 lg:py-10">
    <div class="mb-6 lg:mb-8">
      <h1 class="text-2xl tracking-tight sm:text-3xl">{title}</h1>
      <p class="mt-2 text-muted-foreground">{description}</p>
    </div>

    <nav
      class="mb-8 inline-flex flex-wrap gap-1 rounded-lg border border-border bg-card p-1"
      aria-label="Admin sections"
    >
      {
        sections.map((section) => {
          const active = isActive(section.href);
          return (
            <a
              href={section.href}
              aria-current={active ? 'page' : undefined}
              class={`flex h-9 items-center rounded-md px-3 text-sm transition-colors ${
                active
                  ? 'bg-secondary font-semibold text-foreground'
                  : 'font-medium text-muted-foreground hover:text-foreground'
              }`}
            >
              {section.label}
            </a>
          );
        })
      }
    </nav>

    <slot />
  </div>
</MainLayout>
