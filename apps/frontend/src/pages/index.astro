---
export const prerender = false;

import MainLayout from '@/layouts/MainLayout.astro';
import { getAllGames } from '@/services/games';
import { getAllReviews } from '@/services/reviews';
import { ssrCookieHeader, hasSession } from '@/services/ssr-auth';
import type { GameResponse, PaginatedReviewsResponse } from '@glitch/shared-types';

// ============================================================================
// Server-Side Data Fetching
// The landing page shows real catalogue entries and real reviews. If the API is
// unavailable the page degrades to the hero and the way-in links.
// ============================================================================

let topGames: GameResponse[] = [];
let latestReviews: PaginatedReviewsResponse | null = null;

const cookieHeader = await ssrCookieHeader(Astro.request.headers.get('cookie') || undefined);

// A signed-in visitor already has an account, so the hero offers the thing they
// actually want next instead of a sign-up prompt. Read from the request cookies
// during this SSR render, so there is no signed-out flash to correct on the client.
const isSignedIn = hasSession(cookieHeader);

const [gamesResult, reviewsResult] = await Promise.allSettled([
  getAllGames({ limit: 6, sortBy: 'averageRating', sortOrder: 'desc' }),
  getAllReviews({ page: 1, limit: 3, sortBy: 'createdAt', sortOrder: 'desc' }, cookieHeader ? { cookie: cookieHeader } : undefined),
]);

if (gamesResult.status === 'fulfilled') {
  topGames = gamesResult.value.data ?? [];
} else {
  console.error('Error fetching games for landing page:', gamesResult.reason);
}

if (reviewsResult.status === 'fulfilled') {
  latestReviews = reviewsResult.value;
} else {
  console.error('Error fetching reviews for landing page:', reviewsResult.reason);
}

const PLACEHOLDER_COVER = '/images/game-placeholder.svg';

const waysIn = [
  {
    href: '/games',
    index: '01',
    title: 'The catalogue',
    copy: 'Filter by genre, platform or release status and find something worth your evening.',
  },
  {
    href: '/reviews',
    index: '02',
    title: 'Reviews',
    copy: 'Long-form takes from players, rated out of ten. No scores handed out by a publisher.',
  },
  {
    href: '/feed',
    index: '03',
    title: 'Your feed',
    copy: 'Follow the players whose taste you trust and see what they are playing right now.',
  },
];

const pageTitle = 'Glitch | A social network for gamers';
const pageDescription =
  'Discover games, write reviews that people actually read, and follow players whose taste you trust. Glitch is the social network built for people who play.';
---

<MainLayout title={pageTitle} description={pageDescription}>
  <!-- ── Hero ──────────────────────────────────────────────────────────────
       A single left-aligned statement owning the fold, closed by the real
       catalogue below it rather than a decorative panel. -->
  <section class="shell pt-12 lg:pt-16">
    <h1 class="max-w-5xl text-4xl leading-[0.98] tracking-tight text-foreground sm:text-5xl lg:text-6xl">
      Find your next favourite game.
      <span class="block text-muted-foreground">Then argue about it.</span>
    </h1>

    <div class="mt-8 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <p class="max-w-xl text-base text-foreground-secondary sm:text-lg">
        Glitch is a social network for gamers: track what you play, write reviews that people
        actually read, and follow the players whose taste you trust.
      </p>

      <div class="flex shrink-0 items-center gap-5">
        <a
          href={isSignedIn ? '/feed' : '/auth/signup'}
          class="inline-flex h-11 items-center rounded-md bg-primary px-5 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary-hover"
          >{isSignedIn ? 'Open your feed' : 'Create your account'}</a
        >
        <a
          href="/games"
          class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
          >Browse the catalogue</a
        >
      </div>
    </div>
  </section>

  {
    topGames.length > 0 && (
      <!-- ── The catalogue, as it actually looks ─────────────────────────── -->
      <section class="shell mt-12 lg:mt-16" aria-labelledby="top-rated-heading">
        <div class="flex items-baseline justify-between gap-4">
          <h2
            id="top-rated-heading"
            class="font-mono text-xs font-medium uppercase tracking-widest text-muted-foreground"
          >
            Highest rated right now
          </h2>
          <a
            href="/games"
            class="text-xs font-medium text-muted-foreground transition-colors hover:text-foreground"
          >
            All games
          </a>
        </div>

        <ul class="mt-5 grid grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-3 lg:grid-cols-6">
          {topGames.map((entry) => (
            <li>
              <a href={`/games/${entry.game.slug}`} class="group block">
                <div class="aspect-[3/4] overflow-hidden rounded-lg border border-border bg-muted">
                  <img
                    src={entry.game.coverImage || PLACEHOLDER_COVER}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="size-full object-cover transition-opacity group-hover:opacity-90"
                  />
                </div>
                <h3 class="mt-3 line-clamp-2 min-h-11 text-sm font-medium text-foreground">{entry.game.title}</h3>
                {entry.game.averageRating ? (
                  <p class="mt-1 flex items-center gap-1 text-xs text-muted-foreground">
                    <svg viewBox="0 0 24 24" class="size-3 fill-primary text-primary" aria-hidden="true">
                      <path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" />
                    </svg>
                    <span class="font-mono">{entry.game.averageRating.toFixed(1)}</span>
                  </p>
                ) : (
                  <p class="mt-1 text-xs text-muted-foreground">Not rated yet</p>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- ── Three ways in ───────────────────────────────────────────────────── -->
  <section class="shell mt-16 lg:mt-24" aria-labelledby="ways-in-heading">
    <h2 id="ways-in-heading" class="sr-only">Explore Glitch</h2>
    <ul class="grid gap-px overflow-hidden rounded-lg border border-border bg-border md:grid-cols-3">
      {
        waysIn.map((way) => (
          <li class="bg-background">
            <a href={way.href} class="group flex h-full flex-col p-6 transition-colors hover:bg-card">
              <span class="font-mono text-xs text-muted-foreground">{way.index}</span>
              <span class="mt-6 flex items-center gap-2 font-display text-2xl font-semibold tracking-tight text-foreground">
                {way.title}
                <svg
                  viewBox="0 0 24 24"
                  class="size-4 shrink-0 text-muted-foreground transition-transform group-hover:translate-x-0.5 group-hover:text-primary"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </span>
              <span class="mt-3 text-sm text-muted-foreground">{way.copy}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    latestReviews && latestReviews.items.length > 0 && (
      <!-- ── Latest from the community ───────────────────────────────────── -->
      <section class="shell mt-16 lg:mt-24" aria-labelledby="latest-reviews-heading">
        <div class="flex items-baseline justify-between gap-4">
          <h2
            id="latest-reviews-heading"
            class="font-mono text-xs font-medium uppercase tracking-widest text-muted-foreground"
          >
            Latest from the community
          </h2>
          <a
            href="/reviews"
            class="text-xs font-medium text-muted-foreground transition-colors hover:text-foreground"
          >
            All reviews
          </a>
        </div>

        <ul class="mt-5 grid gap-6 md:grid-cols-3">
          {latestReviews.items.map((review) => (
            <li>
              <a
                href={`/reviews/${review.id}`}
                class="group flex h-full flex-col rounded-lg border border-border bg-card p-5 interactive-surface hover:border-border-hover"
              >
                <div class="flex items-center gap-3">
                  <div class="h-16 w-12 shrink-0 overflow-hidden rounded-md border border-border bg-muted">
                    <img
                      src={review.game.coverImage || PLACEHOLDER_COVER}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      class="size-full object-cover"
                    />
                  </div>
                  <div class="min-w-0">
                    <h3 class="line-clamp-2 text-sm font-semibold text-foreground">{review.game.title}</h3>
                    <p class="mt-1 flex items-center gap-1 text-xs text-muted-foreground">
                      <svg viewBox="0 0 24 24" class="size-3 fill-primary text-primary" aria-hidden="true">
                        <path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" />
                      </svg>
                      <span class="font-mono">{review.rating}</span>
                      <span class="text-border-strong">/</span>
                      <span class="font-mono">10</span>
                    </p>
                  </div>
                </div>

                <p class="mt-4 line-clamp-4 text-sm text-foreground-secondary">{review.content}</p>

                <p class="mt-auto border-t border-border pt-3 text-xs text-muted-foreground">
                  by <span class="text-foreground-secondary">{review.user.displayName}</span>
                </p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- ── Closing statement ──────────────────────────────────────────────── -->
  <section class="shell mt-16 pb-20 lg:mt-24 lg:pb-28">
    <h2 class="max-w-3xl text-2xl leading-snug tracking-tight text-foreground sm:text-3xl">
      No feed algorithm deciding what you should like.
      <span class="block text-muted-foreground">Just players, games, and opinions worth reading.</span>
    </h2>
    <a
      href="/reviews"
      class="mt-6 inline-block text-sm font-medium text-primary transition-colors hover:text-primary-hover"
    >
      Read what people are saying →
    </a>
  </section>
</MainLayout>
