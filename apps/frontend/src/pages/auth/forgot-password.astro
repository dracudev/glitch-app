---
export const prerender = false;

import AuthLayout from '@/layouts/AuthLayout.astro';
import ForgotPasswordForm from '@/components/auth/ForgotPasswordForm';
import NoScriptFallback from '@/components/fallbacks/NoScriptFallback';
import { hasSession } from '@/services/ssr-auth';

if (hasSession(Astro.request.headers.get('cookie') || undefined)) {
  return Astro.redirect('/feed');
}

const pageTitle = 'Forgot your password';
const pageDescription = 'Reset the password for your Glitch account.';
---

<AuthLayout title={pageTitle} description={pageDescription} noIndex={true}>
  <div class="max-w-md w-full space-y-8">
    <div class="text-center">
      <a href="/" class="inline-block">
        <h1 class="text-2xl tracking-tight sm:text-3xl">Glitch</h1>
        <p class="mt-2 text-sm text-foreground-secondary">The social network for gamers</p>
      </a>
    </div>

    <div class="space-y-6">
      <div class="text-center">
        <h2 class="text-lg font-semibold">Forgot your password?</h2>
        <p class="mt-2 text-sm text-foreground-secondary">
          Enter the email you signed up with and we will send you a reset link.
        </p>
      </div>

      <ForgotPasswordForm client:load />

      <NoScriptFallback client:load feature="password reset form" />
    </div>
  </div>
</AuthLayout>
