---
export const prerender = false;

import MainLayout from '@/layouts/MainLayout.astro';
import ExplorePage from '@/components/games/ExplorePage';
import type { GamesQuery, GameStatus, GameFilterOptions } from '@glitch/shared-types';

import { getAllGames, getFilterOptions } from '@/services/games';

const url = new URL(Astro.request.url);
const searchParams = url.searchParams;

const parseIds = (value: string | null): number[] =>
  (value || '')
    .split(',')
    .map((entry) => Number(entry.trim()))
    .filter((id) => Number.isInteger(id) && id > 0);

const initialQuery: GamesQuery = {
  page: parseInt(searchParams.get('page') || '1', 10),
  limit: parseInt(searchParams.get('limit') || '20', 10),
  sortBy: (searchParams.get('sortBy') as GamesQuery['sortBy']) || 'averageRating',
  sortOrder: searchParams.get('sortOrder') === 'asc' ? 'asc' : 'desc',
  genreIds: parseIds(searchParams.get('genreIds')),
  platformIds: parseIds(searchParams.get('platformIds')),
  search: searchParams.get('search') || '',
  status: (searchParams.get('status') as GameStatus) || undefined,
};

let initialGamesData = null;
let filterOptions: GameFilterOptions | null = null;
let error: string | null = null;

try {
  const [gamesResponse, filters] = await Promise.all([
    getAllGames(initialQuery),
    getFilterOptions().catch(() => null),
  ]);
  initialGamesData = gamesResponse;
  filterOptions = filters;
} catch (err: any) {
  console.error('Error loading explore page:', err);
  error = err?.message || 'Failed to load games';
}

const title = initialQuery.search
  ? `Search: "${initialQuery.search}" | Glitch`
  : 'Explore | Glitch';

const description = initialQuery.search
  ? `Search results for "${initialQuery.search}" - Discover and review video games`
  : 'Discover thousands of video games, read reviews, and share your gaming experiences with the Glitch community.';

const canonicalUrl = new URL('/games', Astro.site ?? Astro.request.url);
---

<MainLayout title={title} description={description}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalUrl.toString()} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl.toString()} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: title,
        description,
        url: canonicalUrl.toString(),
      })}
    />
  </Fragment>

  {error ? (
    <div class="container mx-auto px-4 py-8">
      <div class="rounded-lg bg-red-50 p-6 text-center dark:bg-red-900/20">
        <h2 class="text-xl font-semibold text-red-900 dark:text-red-100">Failed to Load Games</h2>
        <p class="mt-2 text-red-700 dark:text-red-300">{error}</p>
        <button onclick="window.location.reload()" class="mt-4 rounded-lg bg-red-600 px-4 py-2 text-white hover:bg-red-700">Try Again</button>
      </div>
    </div>
  ) : (
    <ExplorePage
      initialGames={initialGamesData}
      filterOptions={filterOptions}
      initialQuery={initialQuery}
      client:load
    />
  )}
</MainLayout>
