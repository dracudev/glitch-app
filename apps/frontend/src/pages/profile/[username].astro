---
export const prerender = false;

import MainLayout from '@/layouts/MainLayout.astro';
import ProfilePage from '@/components/profile/ProfilePage';
import { apiClient } from '@/services/api';
import { ssrCookieHeader } from '@/services/ssr-auth';
import { getAvatarUrl } from '@/lib/avatar';
import type { UserProfile } from '@glitch/shared-types';

// Server-Side Data Fetching

const { username } = Astro.params;

if (!username) {
  return Astro.redirect('/404');
}

let profile: UserProfile | null = null;

try {
  // Forward cookies so the backend can tell if the viewer follows this profile
  const cookieHeader = await ssrCookieHeader(Astro.request.headers.get('cookie') || undefined);
  profile = await apiClient.get<UserProfile>(
    `users/profile/${username}`,
    {},
    cookieHeader ? { cookie: cookieHeader } : undefined,
  );
} catch (err: any) {
  if (err.status === 404) {
    return new Response(null, {
      status: 404,
      statusText: 'User not found',
    });
  }

  console.error('Error fetching user profile:', err);
}

if (!profile) {
  return new Response(null, {
    status: 500,
    statusText: 'Internal Server Error',
  });
}

// SEO Meta Tags

const displayName = profile.displayName || profile.username;
const pageTitle = `${displayName} (@${profile.username}) - Glitch`;
const pageDescription = profile.bio 
  ? `${profile.bio} - View ${displayName}'s gaming profile, reviews, and activity on Glitch.`
  : `View ${displayName}'s gaming profile, reviews, and activity on Glitch. Follow to see their latest game reviews and recommendations.`;

const profileImage = getAvatarUrl(profile, 512, 'png');

const canonicalURL = new URL(`/profile/${profile.username}`, Astro.site || Astro.url.origin).toString();

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  'mainEntity': {
    '@type': 'Person',
    'name': displayName,
    'alternateName': profile.username,
    'description': profile.bio || `Gaming profile for ${displayName}`,
    'image': profileImage,
    'url': canonicalURL,
    'interactionStatistic': [
      {
        '@type': 'InteractionCounter',
        'interactionType': 'https://schema.org/WriteAction',
        'userInteractionCount': profile.stats.reviewsCount,
        'name': 'Reviews'
      },
      {
        '@type': 'InteractionCounter',
        'interactionType': 'https://schema.org/FollowAction',
        'userInteractionCount': profile.stats.followersCount,
        'name': 'Followers'
      },
      {
        '@type': 'InteractionCounter',
        'interactionType': 'https://schema.org/FollowAction',
        'userInteractionCount': profile.stats.followingCount,
        'name': 'Following'
      }
    ]
  }
};

---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  image={profileImage}
  canonicalURL={canonicalURL}
  noIndex={profile.isPrivate}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <ProfilePage 
    profile={profile}
    username={username}
    client:load
  />
</MainLayout>
